# Sunny DevFix runs locally by default.
DEVFIX_HOST=127.0.0.1
DEVFIX_PORT=8000

# Safe execution is disabled unless an isolated Docker runner is configured.
DEVFIX_SANDBOX_ENABLED=false
DEVFIX_SANDBOX_IMAGE=sunny-devfix:local

# Bounded inputs keep analysis predictable.
DEVFIX_MAX_SOURCE_BYTES=20000
DEVFIX_MAX_TRACEBACK_BYTES=20000
