{
  "manifest_version": 3,
  "name": "Sunny DevFix · Local Editor Prototype",
  "version": "0.1.0",
  "description": "Experimental local guardian overlay for localhost text editors.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
